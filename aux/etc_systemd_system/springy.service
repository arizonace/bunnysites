[Unit]
Description=Spring Boot BunnySite Starter
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=bunnyuser
Group=bunnyuser
WorkingDirectory=/var/www/bunnysites/java-example

Environment="SERVER_ADDRESS=127.0.0.1"
Environment="SERVER_PORT=8081"

ExecStart=/usr/bin/java -jar /var/www/bunnysites/java-example/target/java-example-0.0.1-SNAPSHOT.jar

Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=027

# Lightweight service hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target